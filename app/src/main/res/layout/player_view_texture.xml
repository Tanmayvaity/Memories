<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView backed by a TextureView so zoomed (cropped) video is clipped to its bounds.
     The default SurfaceView ignores clipping and would spill outside the pager.
     Surface type can only be set from XML, hence this layout. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
